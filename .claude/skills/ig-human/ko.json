  "asks": [
    {"name": "comment a keyword", "regex": "댓글.{0,15}(?:남겨|달아|적어|써\\s?주|주세요)"},
    {"name": "DM me", "regex": "(?:DM|디엠|메시지|문의).{0,6}(?:주세요|보내|남겨|주시면)"},
    {"name": "save this", "regex": "저장(?:해|하세요|해두|해\\s?놓)"},
    {"name": "share this", "regex": "공유(?:해|하세요)"},
    {"name": "follow", "regex": "팔로우(?:하|해|하고|부탁)"},
    {"name": "link in bio", "regex": "프로필\\s?링크|링크는\\s?프로필|프로필\\s?(?:상단|에)\\s?링크"},
    {"name": "swipe or tap", "regex": "(?:옆으로\\s?)?넘겨\\s?보|스와이프"},
    {"name": "answer a question", "regex": "골라\\s?주세요|알려\\s?주세요|어떤\\s?(?:게|색|컬러|사이즈)\\s?(?:더\\s?)?(?:좋|나아|예뻐)"}
  ],

  "filler_tags": [
    "#좋아요", "#좋반", "#좋튀", "#맞팔", "#선팔", "#선팔하면맞팔", "#맞팔해요", "#소통", "#소통해요",
    "#팔로우", "#팔로우미", "#팔로우환영", "#일상", "#데일리", "#인친", "#인친환영", "#인스타그램",
    "#좋아요반사", "#팔로워", "#셀스타그램"
  ],

  "dealbreakers": [
    {"regex": "^\\s*(?:안녕하세요|여러분\\s?안녕|반갑습니다)", "msg": "인사로 시작합니다. 피드에 인사받으러 온 사람은 없습니다."},
    {"regex": "(?:이번|오늘)\\s?(?:영상|릴스|포스팅|게시물)에서는|(?:보여|알려|소개해)\\s?드릴게요|알아보(?:겠|도록\\s?하겠)습니다", "msg": "영상 서두(프리앰블)입니다. 지우고 결론부터 말하세요."},
    {"regex": "^\\s*(?:스크롤\\s?(?:멈|그만)|잠깐만요|넘기지\\s?마)", "msg": "\"스크롤 멈춰\"로 시작합니다. 주의를 달라고 하는 건 아직 못 얻었다는 뜻입니다."}
  ],

  "formal_endings": "(?:습니다|니다|입니다|됩니다|합니다|것이다|이다)[.!?]*$",

  "words": [
    {"find": "다양한", "replace": "여러", "family": "ko-adjectives"},
    {"find": "혁신적인", "replace": "새로운", "family": "ko-adjectives"},
    {"find": "무엇보다도", "replace": "무엇보다", "family": "ko-connectives"},
    {"find": "게임 체인저", "replace": "큰 변화", "family": "ko-buzzwords"},
    {"find": "결론적으로", "replace": "", "family": "ko-connectives"},
    {"find": "요약하자면", "replace": "", "family": "ko-connectives"},
    {"find": "궁극적으로", "replace": "결국", "family": "ko-connectives"}
  ],

  "structures": [
    {"id": "ko-not-just", "regex": "(?:단순(?:히|한)?\\s?\\S{1,15}(?:이|가)?\\s?아니라|뿐만\\s?아니라)", "name": "\"단순히 X가 아니라 Y\" / \"X뿐만 아니라\"", "fix": "진짜 하고 싶은 한 가지만 말하세요. 앞의 대비 구조를 지우세요."},
    {"id": "ko-isnt-about", "regex": "(?:이|가)\\s?아닙니다\\.\\s*\\S{1,20}(?:입니다|이에요|예요)", "name": "\"X가 아닙니다. Y입니다.\"", "fix": "Y부터 말하세요. 뒤집기 구조 자체가 기계 티입니다."},
    {"id": "ko-preamble", "regex": "(?:이번|오늘)\\s?(?:영상|릴스|포스팅|게시물)에서는|알아보(?:겠|도록\\s?하겠)습니다|소개해\\s?드리(?:겠|려고)", "name": "서두/예고 문장", "fix": "결과부터 쓰세요. 예고는 지우세요."},
    {"id": "ko-cta-bait", "regex": "놓치지\\s?마세요|지금\\s?바로\\s?(?:확인|구매|클릭|신청)|팔로우\\s?부탁|좋아요(?:와|\\s?및|\\s?그리고)?\\s?팔로우|친구(?:를)?\\s?태그|소환해", "name": "반사적인 CTA / 팔로우 유도", "fix": "이 게시물이 정말 얻을 수 있는 행동 하나만 요청하세요."},
    {"id": "ko-hedge", "regex": "라고\\s?할\\s?수\\s?있(?:습니다|어요)|것(?:이|은)\\s?중요합니다|라고\\s?생각합니다", "name": "얼버무리는 문장 끝", "fix": "단정하세요. \"~라고 할 수 있습니다\"는 \"~입니다\"로."},
    {"id": "ko-rhetorical", "regex": "(?m)^\\s*(?:결과는|정답은|이유는|비결은|답은)\\?\\s*$", "name": "한 단어 자문자답 (\"결과는?\")", "fix": "질문 줄을 지우고 답을 바로 쓰세요."}
  ],

  "skip_structures_for_korean": ["caps-shout"]
